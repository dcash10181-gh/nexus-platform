# ─── NEXUS Railway deployment — environment variables ───────────────────────
# Set these in the Railway service "Variables" tab. Do NOT commit real values.

# --- Core ---
NEXUS_ENV=production
SERVE_FRONTEND=true
FRONTEND_DIST=/app/static
# Railway injects PORT automatically; no need to set it.

# --- Demo API key (stable, survives restarts) ---
# Generate one: python3 -c "import secrets; print('nxk_trial_'+secrets.token_hex(16))"
# The SAME value MUST also be passed as build arg VITE_NEXUS_DEMO_KEY so the
# frontend authenticates to the conversational endpoint.
NEXUS_DEMO_KEY=nxk_trial_REPLACE_ME

# --- LLM provider (REAL inference for the demo, free tier) ---
# Groq: free, fast, OpenAI-compatible. Get a key at console.groq.com.
LLM_PROVIDER=openai
OPENAI_API_KEY=gsk_REPLACE_ME_groq_key
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
# Fallback (flow-only screenshots, NOT a live buyer demo): LLM_PROVIDER=mock

# --- Vector store (Qdrant Cloud free tier — external) ---
QDRANT_URL=https://YOUR-CLUSTER.qdrant.io:6333
QDRANT_API_KEY=REPLACE_ME_qdrant_cloud_key

# --- Knowledge graph: DISABLED for the conversational-wedge demo ---
# Not required by the conversational layer. Leave unset; the graph "warns but
# doesn't crash" on startup (handled in main.py lifespan).
# NEO4J_URI=
# NEO4J_USER=
# NEO4J_PASSWORD=
