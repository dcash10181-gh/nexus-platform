# NEXUS Platform — Environment Configuration
# Everything works out of the box with these defaults.
# No API keys required to run in demo mode.

# ── LLM Provider ──────────────────────────────────────────────────────────
# mock = runs without any API key (default, works immediately)
# anthropic = uses Claude (add ANTHROPIC_API_KEY below)
# openai = uses GPT (add OPENAI_API_KEY below)
LLM_PROVIDER=mock

# Uncomment and add your key to enable real AI responses:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── Database passwords (change in production) ─────────────────────────────
NEO4J_PASSWORD=nexus-dev-password

# ── Platform settings ─────────────────────────────────────────────────────
NEXUS_ENV=development
NEXUS_LICENSE_KEY=trial
NEXUS_ADMIN_SECRET=nexus-admin-dev
DEMO_MODE=true

# ── Optional: TMDB for real movie posters ─────────────────────────────────
# Free at themoviedb.org for personal use. Leave blank to use built-in catalog.
# TMDB_API_KEY=
