# NEXUS Platform — environment configuration
# Copy to .env and fill in keys for full functionality

# ─── LLM Backend ────────────────────────────────────────────────────
# NEXUS uses an MCP-style orchestrator — swap providers without touching code.
# Supported: anthropic | openai | local (Ollama) | azure
LLM_PROVIDER=anthropic

# Anthropic Claude (recommended default — best on conversational CRS)
ANTHROPIC_API_KEY=

# OpenAI (alternative)
OPENAI_API_KEY=

# Local Ollama (privacy mode — runs on your hardware)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.1:8b

# ─── Licensing ──────────────────────────────────────────────────────
# `trial` = 30-day evaluation (1,000 user cap, all features unlocked)
# Paid keys at https://nexus.ai/license
NEXUS_LICENSE_KEY=trial

# ─── Runtime ────────────────────────────────────────────────────────
NEXUS_ENV=development
LOG_LEVEL=INFO

# ─── Multi-tenant (Enterprise license only) ─────────────────────────
# NEXUS_TENANT_MODE=multi
# NEXUS_DEFAULT_TENANT=acme-streaming

# ── TMDB Integration (optional) ─────────────────────────────────────────
# Get a free key at developers.themoviedb.org — unlocks real posters + metadata
TMDB_API_KEY=

# ── Admin ────────────────────────────────────────────────────────────────
# Change this before deploying to production
NEXUS_ADMIN_SECRET=nexus-admin-dev

# ── Demo Mode ────────────────────────────────────────────────────────────
# Set to true for hosted live demo instances
DEMO_MODE=false
DEMO_USER_ID=demo-user-nexus
