# NEXUS Platform — Environment Configuration
# Copy to .env and fill in your values.

# ── LLM Provider ──────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=          # Required for anthropic provider
OPENAI_API_KEY=             # Optional alternative

# ── Qdrant Vector Database ────────────────────────────────────────────────
# Local Docker (default):
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
# Qdrant Cloud (production):
# QDRANT_URL=https://YOUR_CLUSTER_ID.us-east4-0.gcp.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_cloud_api_key

# ── Neo4j Knowledge Graph ─────────────────────────────────────────────────
# Local Docker (default):
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexus-dev-password
# Neo4j AuraDB (production):
# NEO4J_URI=neo4j+s://YOUR_INSTANCE.databases.neo4j.io
# NEO4J_PASSWORD=your_aura_password

# ── NEXUS License ─────────────────────────────────────────────────────────
NEXUS_LICENSE_KEY=trial

# ── Environment ────────────────────────────────────────────────────────────
NEXUS_ENV=development
LOG_LEVEL=INFO

# ── Admin ────────────────────────────────────────────────────────────────
NEXUS_ADMIN_SECRET=nexus-admin-dev

# ── TMDB (optional) ───────────────────────────────────────────────────────
TMDB_API_KEY=

# ── Demo Mode ─────────────────────────────────────────────────────────────
DEMO_MODE=false
DEMO_USER_ID=demo-user-nexus
